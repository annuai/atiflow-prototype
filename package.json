{
  "name": "ati-flow-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ratchet": "node tools/lint-ratchet.mjs",
    "lint:ratchet:update": "node tools/lint-ratchet.mjs --update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:imports": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "check:imports:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json",
    "check": "npm run typecheck && npm run lint:ratchet && npm run check:imports && npm run format:check && npm test",
    "audit:map": "vite-node tools/audit-nav.ts",
    "audit:architecture": "node tools/architecture-audit.mjs",
    "test:e2e": "playwright test",
    "derive:zones": "vite-node tools/derive-zones/derive-zones.ts",
    "build:dummy-erp": "node tools/build-dummy-erp.mjs",
    "test:browsers": "playwright test -c playwright.browsers.config.ts",
    "test:browsers:install": "playwright install chromium firefox webkit",
    "convert:drawing": "python3 -I tools/drawing-convert/convert.py",
    "convert:pointcloud": "python3 -I tools/pointcloud-to-dxf/pointcloud_to_dxf.py"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/vite": "^4.3.3",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.23",
    "fflate": "^0.8.3",
    "minisearch": "^7.2.0",
    "motion": "^13.5.1",
    "posthog-js": "^1.438.15",
    "react": "^19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-stately": "^3.51.0",
    "read-excel-file": "^9.3.12",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "three": "^0.165.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "vitest-axe": "^0.1.0"
  }
}
